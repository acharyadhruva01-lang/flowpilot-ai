# Ollama is the default; run `ollama pull llama3.2` first.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional alternative: set LLM_PROVIDER=openai and supply a key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional GitHub token raises API limits and enables access to repositories you can read
GITHUB_TOKEN=
# Optional Slack incoming webhook. Only used after explicit UI approval.
SLACK_WEBHOOK_URL=
# Restrict GitHub access to public repositories by default
ALLOW_PRIVATE_REPOS=false
# Set a long random secret in deployed environments; required to post to Slack
APP_SECRET=
DATABASE_PATH=flowpilot.db
